ncludedResources\": [\n              \"sample1.cpd.ibm.com\",\n              \"sample2.cpd.ibm.com\",\n              \"sample3.cpd.ibm.com\"\n            ]\n          },\n          {\n            \"backupName\": \"deployments\",\n            \"includedResources\": [\n              \"Deployment\"\n            ]\n          },\n          {\n            \"backupName\": \"everything\",\n            \"excludedResources\": [\n              \"ConfigMap\",\n              \"Secret\",\n              \"Deployment\",\n              \"sample1.cpd.ibm.com\",\n              \"sample2.cpd.ibm.com\",\n              \"sample3.cpd.ibm.com\"\n            ]\n          }\n        ]\n      },\n      \"pvcSelector\": {\n        \"matchLabels\": {\n          \"any-pvc-label\": \"value\"\n        }\n      },\n      \"replicationState\": \"primary\",\n      \"s3Profiles\": [\n        \"s3-profile-of-east\",\n        \"s3-profile-of-west\"\n      ]\n    }\n  }\n]",
